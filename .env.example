# Copy to `.env` (gitignored) or export in your shell.

# Dashboard (required for `make up` / `helios serve`)
# Generate with: openssl rand -hex 32
HELIOS_DASHBOARD_API_KEY=change-me-to-a-long-random-secret

# Signing (required for `helios key generate` unless --allow-unencrypted)
# HELIOS_KEY_PASSPHRASE=use-a-real-secret
# HELIOS_KEY_DIR=~/.helios/keys
