[helios]
signing_key = "~/.helios/keys/helios.key"
audit_db = "~/.helios/helios.db"
cache_dir = "~/.helios/cache"
log_level = "INFO"

[helios.checks]
enabled = ["reference_genome", "container_pinning", "mane_transcripts", "vus_rate", "crypt4gh_output"]
reference_genome_required = "GRCh38"
mane_pass_threshold = 0.90
mane_warn_threshold = 0.50
container_digest_required = false

[helios.export]
default_format = "json"
output_dir = "./helios-reports"
include_rocrate = true
ai_act_fragment = false

[helios.dashboard]
allow_delete = false
